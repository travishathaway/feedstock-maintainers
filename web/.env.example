# Absolute base URL of the deployed site, injected at build time in CI
# (.github/workflows/pages.yml). Leave unset for local development —
# the dev server serves static assets from the site root already.
# VITE_SITE_BASE_URL=https://travishathaway.github.io/feedstock-maintainers/

# Root-relative base path the site is served from (SvelteKit's `kit.paths.base`, read directly
# by vite.config.ts via process.env -- NOT a VITE_-prefixed client env var). Set in CI
# (.github/workflows/pages.yml) since GitHub Pages serves this project under
# /feedstock-maintainers/, not the domain root. Leave unset for local dev/preview, which serve
# from the root. Must start with "/" and not end with one.
# BASE_PATH=/feedstock-maintainers
